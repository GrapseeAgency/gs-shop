                    whileHover={{ scale: 1.1 }}
                  >
                    <Icon className={`h-4 w-4 ${index === milestones.length - 1 ? '' : 'text-primary'}`} />
                  </motion.div>
                  {index < milestones.length - 1 && (
                    <div className="w-0.5 flex-1 bg-gradient-to-b from-primary/30 to-border/30 my-1" />
                  )}
                </div>
                <div className="pb-5 flex-1">
                  <div className="flex items-center gap-2 mb-0.5">
                    <span className="text-[10px] font-bold text-primary bg-primary/10 px-1.5 py-0.5 rounded">{milestone.year}</span>
                    <p className="text-sm font-semibold text-foreground">{milestone.event}</p>
                  </div>
                  <p className="text-[11px] text-muted-foreground leading-relaxed">{milestone.desc}</p>
                </div>
              </motion.div>
            )
          })}
        </div>
      </section>

      <Separator className="my-5" />

      {/* Stats Counter */}
      <section className="mb-6">
        <motion.h3
          className="mb-3 text-sm font-bold text-foreground"
