                <div className="flex-1 min-w-0">
                  <p className="text-sm font-semibold text-foreground">{val.label}</p>
                  <p className="text-[11px] text-muted-foreground leading-relaxed">{val.desc}</p>
                </div>
              </motion.div>
            )
          })}
        </div>
      </section>

      <Separator className="my-5" />

      {/* Team Section */}
      <section className="mb-6">
        <motion.h3
          className="mb-3 text-sm font-bold text-foreground"
          initial={{ opacity: 0 }}
          animate={{ opacity: 1 }}
