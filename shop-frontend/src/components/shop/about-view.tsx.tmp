          <p className="text-sm leading-relaxed text-muted-foreground">
            To become the world&apos;s most trusted digital services marketplace  -  where every business, from startups to enterprises, can discover, compare, and purchase premium digital solutions with the confidence and ease of a luxury shopping experience.
          </p>
        </div>
      </motion.section>

      {/* Mission & Vision Cards */}
      <motion.section
