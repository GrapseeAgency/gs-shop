        </motion.h3>
        <div className="grid grid-cols-2 gap-2">
          {teamMembers.map((member, index) => (
            <motion.div
              key={member.name}
              className="rounded-2xl border border-border/50 bg-card p-3 text-center hover:border-primary/20 transition-all"
              initial={{ opacity: 0, y: 15 }}
              animate={{ opacity: 1, y: 0 }}
              transition={{ delay: 0.06 * index }}
              whileHover={{ scale: 1.02 }}
            >
              <div className="flex h-12 w-12 items-center justify-center rounded-full bg-gradient-to-br from-primary/20 to-primary/5 mx-auto mb-2">
                {(() => { const Icon = member.icon; return <Icon className="h-6 w-6 text-primary" />; })()}
              </div>
              <p className="text-xs font-semibold text-foreground line-clamp-1">{member.name}</p>
              <p className="text-[9px] text-primary font-medium mb-1">{member.role}</p>
              <p className="text-[9px] text-muted-foreground leading-tight line-clamp-2">{member.desc}</p>
            </motion.div>
          ))}
        </div>
      </section>

      <Separator className="my-5" />

      {/* Awards & Recognition */}
      <section className="mb-6">
        <motion.h3
          className="mb-3 text-sm font-bold text-foreground flex items-center gap-2"
          initial={{ opacity: 0 }}
          animate={{ opacity: 1 }}
        >
          <Trophy className="h-4 w-4 text-amber-400" />
          Awards & Recognition
        </motion.h3>
        <div className="space-y-2">
          {awards.map((award, index) => (
            <motion.div
              key={award.title}
              className="flex items-center gap-3 rounded-xl border border-border/50 bg-card p-3 hover:border-amber-500/20 transition-colors"
              initial={{ opacity: 0, x: 10 }}
              animate={{ opacity: 1, x: 0 }}
              transition={{ delay: 0.08 * index }}
            >
              <div className="flex h-9 w-9 flex-shrink-0 items-center justify-center rounded-lg bg-amber-500/10">
                <Award className="h-4 w-4 text-amber-400" />
              </div>
              <div className="flex-1 min-w-0">
                <p className="text-xs font-semibold text-foreground">{award.title}</p>
                <p className="text-[10px] text-muted-foreground">{award.org} - {award.year}</p>
              </div>
            </motion.div>
          ))}
        </div>
      </section>

      <Separator className="my-5" />

      {/* CTA - Join Rewards */}
      <motion.div
