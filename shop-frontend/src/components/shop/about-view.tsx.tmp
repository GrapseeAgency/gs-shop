          <h4 className="text-xs font-bold text-foreground mb-1">Our Promise</h4>
          <p className="text-[10px] leading-relaxed text-muted-foreground">
            Quality without compromise, delivery without delay, support without limits.
          </p>
        </motion.div>
      </motion.section>

      <Separator className="my-5" />

      {/* Timeline - Our Story */}
      <section className="mb-6">
        <motion.h3
