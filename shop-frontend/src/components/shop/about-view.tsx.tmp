        <div className="absolute inset-0 bg-gradient-to-br from-primary/30 via-primary/15 to-violet-500/20 animate-pulse" style={{ animationDuration: '4s' }} />
        <div className="absolute inset-0 bg-gradient-to-tr from-transparent via-transparent to-white/5 dark:to-white/5" />
        <div className="relative z-10">
          <div className="flex items-center gap-3 mb-3">
            <div className="flex h-14 w-14 items-center justify-center rounded-2xl bg-primary shadow-lg shadow-primary/30">
