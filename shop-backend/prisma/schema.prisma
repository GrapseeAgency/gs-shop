}

model Device {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  deviceType  String   // "mobile", "tablet", "desktop"
  platform    String   // "ios", "android", "web"
  pushToken   String?  // Firebase/OneSignal token
  deviceName  String?
  isActive    Boolean  @default(true)
  lastSeenAt  DateTime @default(now())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([userId, isActive])
  @@index([pushToken])
}

model ModerationLog {
  id            String   @id @default(cuid())
  action        String
  targetId      String
  targetType    String
  reason        String?
  status        String?
  notes         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model NearbyAlert {
  id            String   @id @default(cuid())
  userId        String
  productId     String
  location      String?
  distance      Float?
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model Testimonial {
  id        String   @id @default(cuid())
  name      String
  role      String
  company   String
  avatar    String?
  rating    Int      @default(5)
  text      String
  isActive  Boolean  @default(true)
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// === DYNAMIC PRICING SYSTEM ===

model CompetitorPrice {
  id          String   @id @default(cuid())
  productId   String
  product     Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  competitor  String   // e.g., "Envato", "ThemeForest", "CompetitorA"
  price       Float
  currency    String   @default("USD")
  url         String?  // Link to competitor product
  scrapedAt   DateTime @default(now())
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([productId])
  @@index([competitor])
  @@index([scrapedAt])
}

model PricingRule {
  id                String   @id @default(cuid())
  productId         String?
  product           Product? @relation(fields: [productId], references: [id], onDelete: Cascade)
  name              String   // e.g., "Always 10% cheaper than Envato"
  ruleType          String   // "cheapest_competitor", "percentage_below", "fixed_price", "range"
  targetCompetitor  String?  // Competitor name or "market_average"
  adjustment        Float    // Percentage or fixed amount
  minPrice          Float?   // Floor price - never go below this
  maxPrice          Float?   // Ceiling price - never go above this
  isActive          Boolean  @default(true)
  lastAppliedAt     DateTime?
  lastAppliedPrice  Float?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([productId])
  @@index([isActive])
}

model PriceChangeLog {
  id            String   @id @default(cuid())
  productId     String
  product       Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  oldPrice      Float
  newPrice      Float
  reason        String   // "manual", "pricing_rule", "flash_sale", "competitor_change"
  triggeredBy   String?  // Admin user ID or "system"
  ruleId        String?  // If triggered by pricing rule
  metadata      String?  // JSON: {competitorPrice, marketAvg, etc.}
  createdAt     DateTime @default(now())

  @@index([productId])
  @@index([createdAt])
  @@index([reason])
}

// Security Models
model SecurityLog {
  id        String   @id @default(cuid())
  userId    String
  type      String   // "fraud_check", "balance_check", "payment_verify", etc.
  action    String   // "attempt", "success", "failure", "flagged"
  ipAddress String?
  userAgent String?
  riskScore Int?     // 0-100
  metadata  String?  // JSON
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([type])
  @@index([createdAt])
}

model BlacklistedEmail {
  id        String   @id @default(cuid())
  email     String   @unique
  reason    String?
  riskScore Int      @default(100)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive])
}

model BlacklistedIp {
  id        String   @id @default(cuid())
  ipAddress String   @unique
  reason    String?
  riskScore Int      @default(100)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive])
}

model BlacklistedDevice {
  id          String   @id @default(cuid())
  deviceId    String   @unique
  userAgent   String?
  fingerprint String?
  reason      String?
  riskScore   Int      @default(100)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([isActive])
}

model Chargeback {
  id        String   @id @default(cuid())
  orderId   String
  userId    String
  amount    Float
  reason    String?
  status    String   @default("pending") // "pending", "approved", "rejected"
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([orderId])
  @@index([userId])
}

model InventoryLog {
  id        String   @id @default(cuid())
  productId String
  type      String   // "reserved", "released", "sold", "restocked"
  quantity  Int
  reason    String?
  userId    String?
  createdAt DateTime @default(now())

  @@index([productId])
  @@index([createdAt])
}

// === DIGITAL PRODUCT DELIVERY SYSTEM ===

model DigitalDelivery {
  id            String   @id @default(cuid())
  productId     String   @unique
  product       Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  
  // ZIP file delivery
  zipFileUrl    String?
  zipFileSize   Int?
  zipUploadedAt DateTime?
  
  // GitHub repository
  githubRepoUrl  String?
  githubRepoName String?
  
  // Folder structure (for organized downloads)
  folderStructure String? // JSON
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  @@index([productId])
}

model GitHubAccess {
  id          String   @id @default(cuid())
  orderId     String   @unique
  productId   String
  username    String   // GitHub username
  repoUrl     String?
  status      String   @default("pending") // pending, granted, revoked
  grantedAt   DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  @@index([orderId])
  @@index([productId])
  @@index([status])
}

model ChatSession {
  id            String   @id @default(cuid())
  userId        String?  // Link to User if logged in
  user          User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  type          String   @default("general") // 'general' (pre-purchase) | 'paid' (post-purchase)
  orderId       String?  @unique  // Only for paid chats
  order         Order?   @relation(fields: [orderId], references: [id], onDelete: SetNull)
  productId     String?           // For general product-specific chats
  product       Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
  customerEmail String
  customerName  String?           // For general chats without order
  productName   String
  roomId        String?           // Grapsee chat room ID
  status        String   @default("active") // active, closed, waiting
  priority      String   @default("normal") // low, normal, high (paid = high)
  assignedTo    String?           // Grapsee agent ID
  unreadCount   Int      @default(0)
  lastMessageAt DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  messages      ChatMessage[]
  
  @@index([userId])
  @@index([orderId])
  @@index([productId])
  @@index([status])
  @@index([type])
  @@index([assignedTo])
  @@index([lastMessageAt])
}

// Update ChatMessage to add session relation
model ChatMessage {
  id        String   @id @default(cuid())
  sessionId String?
  session   ChatSession? @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  roomId    String?
  userId    String?
  message   String
  sender    String
  agentName String?
  agentId   String?
  read      Boolean  @default(false)
  timestamp DateTime @default(now())
  
  @@index([sessionId])
  @@index([roomId])
  @@index([timestamp])
}

// DeviceToken model for push notification device registration
model DeviceToken {
  id        String   @id @default(cuid())
  userId    String
  token     String
  platform  String   // web, ios, android
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  @@unique([userId, token])
  @@index([userId])
  @@index([token])
  @@index([isActive])
}
