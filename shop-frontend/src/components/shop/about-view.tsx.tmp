'use client'

import { motion } from 'framer-motion'
import { Crown, Code2, Palette, BarChart3, Headphones, Settings } from 'lucide-react'
import {
  ArrowLeft,
  Globe,
  Users,
  Award,
  Heart,
  Target,
  Zap,
  Shield,
  Code,
  Sparkles,
  Rocket,
  TrendingUp,
  HeadphonesIcon,
  Gem,
  Trophy,
  Star,
  CheckCircle2,
  ArrowRight,
} from 'lucide-react'
import { Button } from '@/components/ui/button'
import { Badge } from '@/components/ui/badge'
import { Separator } from '@/components/ui/separator'
import { useShopRouter } from '@/hooks/use-shop-router'
import { useShopStore } from '@/lib/store'
import { toast } from 'sonner'

const milestones = [
  { year: '2020', event: 'Grapsee Founded', desc: 'Started as a small web development studio with a vision to make accessible digital services', icon: Rocket, color: 'from-violet-500/20 to-purple-600/20' },
  { year: '2021', event: 'First 1,000 Users', desc: 'Expanded to mobile app development and reached our first major milestone', icon: Users, color: 'from-blue-500/20 to-cyan-600/20' },
  { year: '2022', event: 'Mobile App Launch', desc: 'Launched our mobile platform bringing digital services to your fingertips', icon: Globe, color: 'from-emerald-500/20 to-teal-600/20' },
  { year: '2023', event: '50K+ Customers', desc: 'Crossed 50,000 happy customers with a 4.9 star average rating', icon: Star, color: 'from-amber-500/20 to-orange-600/20' },
  { year: '2024', event: 'Premium Mall', desc: 'Transformed into a premium digital marketplace with luxury service tiers', icon: Crown, color: 'from-rose-500/20 to-pink-600/20' },
  { year: '2025', event: 'Global Expansion', desc: 'Now serving customers in 120+ countries with localized experiences', icon: TrendingUp, color: 'from-primary/20 to-primary/30' },
]

const teamMembers = [
  { name: 'Sarah Chen', role: 'Chief Executive Officer', icon: Crown, desc: 'Visionary leader with 15+ years in tech. Former VP at a Fortune 500 company.' },
  { name: 'Marcus Rodriguez', role: 'Chief Technology Officer', icon: Code2, desc: 'Full-stack architect. Built platforms serving 10M+ users worldwide.' },
  { name: 'Aisha Patel', role: 'Head of Design', icon: Palette, desc: 'Award-winning designer. 8+ years crafting premium digital experiences.' },
  { name: 'James Kim', role: 'Head of Marketing', icon: BarChart3, desc: 'Growth strategist. Scaled 3 startups from zero to $10M ARR.' },
  { name: 'Elena Volkov', role: 'Head of Support', icon: Headphones, desc: 'Customer champion. 99.8% satisfaction score under her leadership.' },
  { name: 'David Okafor', role: 'Head of Operations', icon: Settings, desc: 'Operations expert. Streamlined delivery times by 60% across all services.' },
]

const values = [
  { icon: Sparkles, label: 'Innovation', desc: 'Pushing boundaries with modern technology and creative solutions that redefine what\'s possible', color: 'text-violet-400', bg: 'bg-violet-400/10' },
  { icon: Shield, label: 'Trust', desc: 'Building lasting relationships through transparency, security, and unwavering reliability', color: 'text-emerald-400', bg: 'bg-emerald-400/10' },
  { icon: Gem, label: 'Quality', desc: 'Every deliverable meets the highest standards ” no compromises, no shortcuts, ever', color: 'text-amber-400', bg: 'bg-amber-400/10' },
  { icon: Heart, label: 'Community', desc: 'Growing together with our users, partners, and the global tech ecosystem we serve', color: 'text-rose-400', bg: 'bg-rose-400/10' },
]

const stats = [
  { value: '50K+', label: 'Happy Customers', icon: Users, color: 'text-blue-400' },
  { value: '500+', label: 'Premium Products', icon: Award, color: 'text-amber-400' },
  { value: '99.9%', label: 'Uptime SLA', icon: Zap, color: 'text-emerald-400' },
  { value: '24/7', label: 'Live Support', icon: HeadphonesIcon, color: 'text-rose-400' },
]

const awards = [
  { title: 'Best Digital Marketplace 2024', org: 'Tech Awards', year: '2024' },
  { title: 'Top E-Commerce Platform', org: 'Digital Commerce', year: '2024' },
  { title: 'Excellence in UX Design', org: 'Design Summit', year: '2023' },
  { title: 'Most  Startup', org: 'Startup World', year: '2022' },
]

const container = {
  hidden: { opacity: 0 },
  show: {
    opacity: 1,
    transition: { staggerChildren: 0.06 },
  },
}

const item = {
  hidden: { opacity: 0, y: 20 },
  show: { opacity: 1, y: 0 },
}

export function AboutView() {
  const { goBack, goCategory, goRewards } = useShopRouter()
