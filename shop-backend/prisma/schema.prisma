  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // Phase 2: Verification & Badges
  verificationBadge String  @default("none") // none, verified, premium, top_seller, platinum
  badges            String? // JSON array of earned badges

  // Phase 2: Commission & Payouts
  commissionRate Float @default(10) // platform percentage
  payoutBalance  Float @default(0)
  totalEarnings  Float @default(0)

  // Phase 2: Analytics
  monthlyRevenue String? // JSON: [{month, revenue, orders}]
  topServices    String? // JSON array of top service IDs
  conversionRate Float   @default(0)

  // Phase 2: Storefront
  storeTheme   String  @default("default")
  customDomain String?
  socialLinks  String? // JSON: {facebook, twitter, linkedin, github}
  story        String?
  isLocal      Boolean  @default(false)

  // Phase 2: Availability
  isAcceptingOrders Boolean @default(true)
  avgResponseTime   Int? // in minutes

  // Phase 2: Followers
  followerCount Int @default(0)
  viewCount     Int @default(0) // Storefront page views

  // Real Seller Center Fields
  userId             String?   @unique
  user               User?     @relation(fields: [userId], references: [id], onDelete: SetNull)
  onboardingProgress Int       @default(0)
  onboardingStatus   String    @default("incomplete")
  isOnboarded        Boolean   @default(false)
  bankAccountName    String?
  bankAccountNumber  String?
  bankRoutingNumber  String?
  paypalEmail        String?
  stripeConnectId    String?
  minPayoutAmount    Float     @default(50)
  autoPayoutEnabled  Boolean   @default(false)
  storePolicies      String?   // JSON: { returns, shipping, privacy }

  // Relations
  auctions           Auction[]
  products           Product[]
  featuredProducts   Product[] @relation("SellerFeaturedProducts")
  onboarding         SellerOnboarding?
  documents          SellerDocument[]
  payouts            SellerPayout[]
  settings           SellerSettings?
  analytics          SellerAnalytics[]
  sellerReviews      SellerReview[]
  messages           SellerMessage[]
  promotions         SellerPromotion[]

  @@index([userId])
  @@index([onboardingStatus])
  @@index([isOnboarded])
}

