      >
        <div className="flex h-12 w-12 items-center justify-center rounded-full bg-primary/20 mx-auto mb-3">
          <Star className="h-6 w-6 text-primary" />
        </div>
        <p className="text-base font-bold text-foreground mb-1">Join Our Rewards Program</p>
        <p className="text-xs text-muted-foreground mb-4 leading-relaxed">
