generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

enum EventType {
  MEGA_SALE
  AUCTION
  COMMUNITY
  BLOG_FEATURED
  FLASH_SALE
}

enum EventStatus {
  UPCOMING
  ACTIVE
  ENDED
  HIDDEN
}

model Event {
  id              String      @id @default(cuid())
  type            EventType
  title           String
  subtitle        String?
  description     String?

  // Time control (strict)
  startTime       DateTime
  endTime         DateTime
  status          EventStatus @default(UPCOMING)

  // Visual customization
  gradientFrom    String      @default("#f97316")
  gradientVia     String?
  gradientTo      String      @default("#dc2626")
  badgeText       String?
  badgeColor      String      @default("#fbbf24")

  // Content
  ctaText         String      @default("Shop Now")
  ctaLink         String?
  discountText    String?

  // Product association (optional)
  productId       String?
  product         Product?    @relation(fields: [productId], references: [id])

  // Auction fields
  startPrice      Int?
  currentBid      Int?
  minBidIncrement Int?        @default(100)
  bidCount        Int         @default(0)

  // Control
  isActive        Boolean     @default(true)
  priority        Int         @default(0)

  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  @@index([type])
  @@index([status])
  @@index([startTime])
  @@index([endTime])
}

model Category {
  id          String     @id @default(cuid())
  name        String
  slug        String     @unique
  description String?
  // Icon options
  icon        String?    // Lucide/icon name
  iconSvg     String?    // Custom SVG code for icon
  iconLottie  String?    // Lottie animation for icon
  iconType    String     @default("icon") // icon, svg, lottie
  // Images
  imageUrl    String?
  bannerUrl   String?
  mobileBannerUrl String? // Mobile-optimized banner
  // Styling
  color       String?    // Primary color hex
  gradient    String?    // Gradient CSS or JSON
  textColor   String?    // Text color for contrast
  // Display
  order       Int        @default(0)
  isFeatured  Boolean    @default(false) // Show on homepage
  showInMenu  Boolean    @default(true)  // Show in navigation
  // Hierarchy
  parentId    String?
  parent      Category?  @relation("CategoryToSubcategory", fields: [parentId], references: [id])
  children    Category[] @relation("CategoryToSubcategory")
  products    Product[]
  // SEO
  metaTitle       String?
  metaDescription String?
  keywords        String?
  // State
  isActive    Boolean    @default(true)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
}

model Product {
  id              String            @id @default(cuid())
  name            String
  slug            String            @unique
  description     String
  price           Float
  comparePrice    Float?
  category        Category          @relation(fields: [categoryId], references: [id])
  categoryId      String
  imageUrl        String?
  images          String? // JSON array of image URLs
  features        String? // JSON array of features
  techStack       String? // JSON array of tech stack
  deliveryTime    String?
  isFeatured      Boolean           @default(false)
  isActive        Boolean           @default(true)
  isNew           Boolean           @default(false)
  isTrending      Boolean           @default(false)
  isFlashDeal     Boolean           @default(false)
  flashExpiresAt  DateTime?
  isVIPOnly       Boolean           @default(false)
  isLuxury        Boolean           @default(false)
  luxuryExpiresAt DateTime?
  isOnSale        Boolean           @default(false)
  isMock          Boolean           @default(false)
  discount        Int               @default(0)
  inventory       Int               @default(0)
  reserved        Int               @default(0)
  rating          Float             @default(0)
  reviewCount     Int               @default(0)
  views           Int               @default(0)
  tags            String? // JSON array of tags
  order           Int               @default(0)
  weight          Float?            // grams
  expiryDate      DateTime?
  ingredients     String?           // For food/cosmetic products
  stock           Int?              // Alias for inventory
  color           String?           // For fashion products
  size            String?           // For fashion products
  ecoScore        Float?            // 0-100
  carbonFootprint Float?            // kg CO2
  reviews         Review[]
  questions       ProductQuestion[]
  priceHistory    PriceHistory[]
  competitorPrices CompetitorPrice[]
  pricingRules    PricingRule[]
  priceChangeLogs PriceChangeLog[]
  auctions        Auction[]
  videos          ProductVideo[]
  cartItems       CartItem[]
  orderItems      OrderItem[]
  nFTCertificates NFTCertificate[]
  productDuelA    ProductDuel[] @relation("ProductDuelA")
  productDuelB    ProductDuel[] @relation("ProductDuelB")
  productViews    ProductView[]
  customerPhotos  CustomerPhoto[]
  flashSales      FlashSale[]
  events          Event[]           // Bidirectional relation for Mega Sale/Auction events
  pvpGames        PvpGame[]
  chatSessions    ChatSession[]
  createdAt       DateTime          @default(now())

  // Seller
  sellerId String?
  seller   Seller? @relation(fields: [sellerId], references: [id])
  featuredSeller Seller? @relation("SellerFeaturedProducts", fields: [sellerId], references: [id])

  // AR/Authenticity
  arModelUrl     String?
  dimensions     String?
  qrCode         String?   @unique
  serialNumber   String?
  isAuthentic    Boolean   @default(false)
  manufacturedAt DateTime?
  batchNumber    String?
  origin         String?
  updatedAt      DateTime  @updatedAt

  // Phase 2: Digital Service Extensions
  complexity         String  @default("medium") // small, medium, large, enterprise
  complexityGuide    String? // Description of scope (landing page vs full app)
  demoUrl            String? // Live demo link
  previewImages      String? // JSON array of preview screenshots
  interactiveDemoUrl String? // Interactive prototype link
  videoDemoUrl       String? // Product demo video

  // Phase 2: Delivery Options
  rushDeliveryAvailable Boolean @default(false)
  rushDeliveryPrice     Float?
  standardDeliveryDays  Int     @default(14)
  rushDeliveryDays      Int     @default(3)

  // Phase 2: Availability (for service slots)
  maxMonthlyOrders   Int @default(10)
  currentMonthOrders Int @default(0)

  // Phase 2: Tech Stack Variants
  techStackOptions String? // JSON: [{name, value, priceModifier}]

  // Phase 2: EMI Support
  emiAvailable Boolean @default(false)
  emiMinAmount Float   @default(5000)

  // SVG & Animation Support
  svgUrl           String?           // Animated SVG thumbnail URL
  svgAnimation     String?           // JSON: {type: "lottie|css|svg", config: {...}}
  lottieUrl        String?           // Lottie animation JSON URL

  // Custom Illustrations (React/HTML/CSS)
  illustrationCode String?           // Custom React/CSS/HTML code for illustrations
  illustrationType String?           // "react", "css", "svg", "lottie"

  // Preview & Thumbnail Options
  thumbnailType    String  @default("image") // image, svg, animation, illustration
  previewUrl       String?           // Live preview/demo URL
  videoThumbnail   String?           // Video thumbnail for product cards

  // Enhanced Product Display
  shortDescription String?           // Short description for product cards
  badge            String?           // Badge text: "New", "Hot", "Sale", "Bestseller"
  badgeColor       String?           // Badge color: "red", "green", "blue", "gold"

  // SEO Fields
  metaTitle        String?           // SEO meta title
  metaDescription  String?           // SEO meta description
  keywords         String?           // SEO keywords (comma separated)
  altText          String?           // Image alt text for accessibility

  // Product Classification
  productType      String  @default("physical") // physical, digital, service, subscription
  sku              String?           @unique      // Stock keeping unit
  barcode          String?           // Product barcode

  // Tax & Shipping
  taxClass         String?           // Tax classification
  taxRate          Float?            // Tax percentage
  shippingClass    String?           // Shipping classification

  // Digital Products
  downloadUrl      String?           // For digital products
  downloadLimit    Int?              // Download limit (null = unlimited)
  fileSize         String?           // File size display
  fileFormat       String?           // File format: PDF, ZIP, etc.

  // Subscription Products
  subscriptionPeriod   String?       // monthly, yearly, weekly
  subscriptionPrice    Float?        // Recurring price
  trialDays            Int?            // Trial period days

  // Gallery Options
  galleryType      String  @default("grid") // grid, slider, masonry
  galleryColumns   Int     @default(3)      // Number of columns

  // Related Products
  relatedProducts  String?           // JSON: [productId1, productId2, ...]
  crossSells       String?           // JSON: [productId1, productId2, ...]
  upsells          String?           // JSON: [productId1, productId2, ...]

  // Phase 2: White Label
  whiteLabelAvailable Boolean @default(false)
  whiteLabelPrice     Float?

  // Product extensions
  variants         String? // JSON array
  specifications   String? // JSON array
  howToUse         String? // JSON
  materials        String? // JSON array
  flashbackProduct FlashbackProduct?
  digitalPurchases DigitalPurchase[]
  digitalDelivery  DigitalDelivery?

  // Sustainability
  packagingType    String? // biodegradable, recyclable, minimal
  isRecyclable     Boolean  @default(false)
  isEcoFriendly    Boolean  @default(false)

  // Product statistics
  totalSales       Int      @default(0)
  wishlistCount    Int      @default(0)

  // Sold status
  isSold           Boolean  @default(false)
  soldTo           String?  // userId of buyer
  buyerUsername    String?  // public display name of buyer
  isPubliclyVisible Boolean  @default(true) // Phase VIII: false = hidden from public shop

  // Additional product fields
  warrantyMonths Int?
  returnDays     Int?
  brand          String?
  isLocal        Boolean  @default(false)

  // Phase I: Architecture & One-of-a-kind
  architectureStyle  String?  // Monolithic, Microservices, Layered, Event-Driven, SOA, Serverless, P2P
  folderStructure    String?  // JSON representation of folder/file structure
  showOneOfAKind     Boolean  @default(true)  // Show "each product is one-of-a-kind" messaging
  isUnique           Boolean  @default(true)  // Product is unique/sold once

  // Relations
  todaysPicks    TodaysPick[]
}

model Order {
  id              String      @id @default(cuid())
  userId          String?
  user            User?       @relation(fields: [userId], references: [id])
  customerName    String
  customerEmail   String?
  customerPhone   String?
  total           Float
  discount        Float       @default(0)
  couponCode      String?
  status          String      @default("pending")
  paymentMethod   String?
  paymentId       String?
  notes           String?
  shippingAddress String?
  trackingNumber  String?
  trackingSteps   String? // JSON array of tracking steps
  items           OrderItem[]
  returnRequests  ReturnRequest[]
  deliveryBooking DeliveryBooking?
  delivery        Delivery?
  hasDeliveryVideo Boolean @default(false)
  chatSession     ChatSession?
  source          String?  // web, mobile, whatsapp, etc.
  metadata        String?  // JSON object for additional order metadata
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  // Phase 2: Payment
  splitPayment   Boolean @default(false)
  walletAmount   Float   @default(0)
  cardAmount     Float   @default(0)
  priceLocked    Boolean @default(false)
  priceLockId    String?
  partialPayment Boolean @default(false)
  amountPaid     Float   @default(0)

  // Phase 2: Project Delivery
  deliverySlotId       String?
  deliveryInstructions String?
  demoCallUrl          String? // For scheduled demo/handoff calls
  demoCallScheduledAt  DateTime?
  projectMilestone     String    @default("requirement_gathering") // requirement_gathering, design, development, testing, delivery, completed
  rushDelivery         Boolean   @default(false)

  // Phase 2: Revisions
  revisionCount Int @default(0)
  maxRevisions  Int @default(3)

  // Phase 2: Delivery Proof
  deliverableUrl     String? // Link to delivered files/GitHub
  deliveryProofImage String? // Screenshot proof
  deliveredAt        DateTime?

  // Phase 2: Notifications
  notifiedMilestones String? // JSON array of completed milestones

  // Digital Products Enhancement
  digitalPurchases DigitalPurchase[]
  nFTCertificates  NFTCertificate[]

  // Trust & Safety
  escrow EscrowTransaction?
}

model OrderItem {
  id          String   @id @default(cuid())
  order       Order    @relation(fields: [orderId], references: [id])
  orderId     String
  productId   String
  product     Product  @relation(fields: [productId], references: [id])
  productName String
  price       Float
  quantity    Int      @default(1)
  imageUrl    String?
}

model Review {
  id            String   @id @default(cuid())
  product       Product  @relation(fields: [productId], references: [id])
  productId     String
  userId        String?
  user          User?    @relation(fields: [userId], references: [id])
  author        String
  title         String?
  rating        Int
  comment       String
  avatar        String?
  helpfulVotes  Int      @default(0)
  isVerified    Boolean  @default(false)
  isFlagged     Boolean  @default(false)
  flagReason    String?
  adminReply    String?
  adminRepliedAt DateTime?
  createdAt     DateTime @default(now())
}

model Brand {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  logo      String?
  icon      String?
  order     Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
}

model Newsletter {
  id        String   @id @default(cuid())
  email     String   @unique
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
}

model Contact {
  id        String   @id @default(cuid())
  name      String
  email     String
  subject   String?
  message   String
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())
}

model User {
  id            String     @id @default(cuid())
  name          String
  email         String     @unique
  password      String?
  avatar        String?
  image         String?
  grapseeId     String?    @unique
  phone         String?
  role          String     @default("customer")
  rewardsPoints Int        @default(0)
  loyaltyTier   String     @default("bronze") // bronze, silver, gold, platinum, diamond
  isActive      Boolean    @default(true)
  emailVerified Boolean    @default(false)
  reviews       Review[]
  giftCards     GiftCard[]
  orders        Order[]
  returnRequests ReturnRequest[]
  addresses     Address[]
  cartItems     CartItem[]
  customerPhotos CustomerPhoto[]
  auctionsWon   Auction[]
  chatSessions  ChatSession[]

  // Digital Products Enhancement
  digitalPurchases    DigitalPurchase[]
  giftCardPurchases   GiftCardDelivery[]   @relation("GiftCardPurchaser")
  studentVerification StudentVerification?

  // NEW revolutionary feature relationships
  liveShoppingSessions       LiveShoppingSession[]
  liveShoppingInteractions   LiveShoppingInteraction[]
  neuralProfile              NeuralProfile?    @relation("NeuralProfile")
  neuralSignals              NeuralSignal[]    @relation("NeuralSignals")
  digitalTwin                DigitalTwin?      @relation("DigitalTwin")
  dnaProfile                 DNAProfile?       @relation("DNAProfile")
  productCompatibilities     ProductCompatibility[] @relation("ProductCompatibilities")
  bioHackSessions            BioHackSession[]
  quantumPredictions         QuantumPrediction[]
  quantumTeleportations      QuantumTeleportation[]
  arSessions                 ARSession[]
  styleEvolution             StyleEvolution?   @relation("StyleEvolution")
  truthAnalyses              TruthAnalysis[]    @relation("TruthAnalyses")
  trendPredictions           TrendPrediction[]
  socialCapital              SocialCapital?    @relation("SocialCapital")
  personalShopper            PersonalShopper?  @relation("PersonalShopper")
  timeTravelSessions         TimeTravelSession[]
  realityCustomization       RealityCustomization? @relation("RealityCustomization")
  gameSessions               GameSession[]
  trendCouncil               TrendCouncil?     @relation("TrendCouncil")
  quantumCollectibles        QuantumCollectible[]

  // PvP Price Guessing
  pvpGuesses                 PvpGuess[]
  pvpGamesHosted             PvpGame[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Phase 2: Gamification & Referrals
  referralCode     String?   @unique
  dailyCheckInDate DateTime?
  currentStreak    Int       @default(0)
  longestStreak    Int       @default(0)
  totalCheckIns    Int       @default(0)

  // Phase 2: Preferences
  fontSize     String  @default("normal") // small, normal, large
  highContrast Boolean @default(false)
  reduceMotion Boolean @default(false)
  language     String  @default("en") // en, bn, hi, ar
  currency     String  @default("BDT") // BDT, USD, INR, AED
  rtl          Boolean @default(false)

  pushEnabled  Boolean @default(true)
  emailEnabled Boolean @default(true)
  smsEnabled   Boolean @default(false)

  // Relations for new features
  musicProfile      MusicProfile?
  spinRecords       UserSpinRecord[]
  biometricProfile  UserBiometricProfile?
  achievements      UserAchievement[]
  wishlistBoards    WishlistBoard[]
  communityPosts    CommunityPost[]
  communityComments CommunityComment[]

  // Phase 1: Real Rewards System
  rewardTransactions RewardTransaction[]

  // Seller Center Relations
  sellerReviews SellerReview[]
  sellerMessages SellerMessage[]
  seller        Seller?
  
  // Device Relations
  devices Device[]
}

model FlashbackProduct {
  id            String   @id @default(cuid())
  productId     String   @unique
  product       Product  @relation(fields: [productId], references: [id])
  originalPrice Float    // Original price before discount
  flashStart    DateTime
  flashEnd      DateTime
  discount      Int      @default(0) // percentage discount during flash
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model Coupon {
  id             String    @id @default(cuid())
  code           String    @unique
  discount       Int?
  discountValue  Int
  discountType   String    @default("percentage") // percentage or fixed
  type           String    @default("percentage") // percentage or fixed (legacy)
  description    String?
  minOrder       Float?
  minOrderAmount Float?
  maxUses        Int?
  usedCount      Int       @default(0)
  isActive       Boolean   @default(true)
  startDate      DateTime  @default(now())
  endDate        DateTime?
  expiresAt      DateTime?
  expiryDate     DateTime?
  maxDiscount    Float?
  appliesTo      String    @default("all") // "all", "products", "categories"
  appliesToIds   String?   // JSON array of product/category IDs
  createdAt      DateTime  @default(now())
}

model GiftCard {
  id         String    @id @default(cuid())
  userId     String?
  user       User?     @relation(fields: [userId], references: [id])
  code       String    @unique
  amount     Float?
  balance    Float
  initialBalance Float @default(0) // Initial amount for tracking
  status     String    @default("active") // active, redeemed, expired, cancelled
  isRedeemed Boolean   @default(false)
  redeemedBy String?
  message    String?
  design     String    @default("classic") // classic, birthday, holiday, premium
  isActive   Boolean   @default(true)
  expiryDate DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  // Recipient info (for sending gift cards)
  recipientEmail String?
  recipientName  String?
  senderName     String?
  sendEmail      Boolean @default(false) // Whether to email the recipient

  // Gift card can be sent to someone
  deliveries GiftCardDelivery[]
}

model Referral {
  id            String   @id @default(cuid())
  referrerCode  String   @unique
  referrerName  String
  referredEmail String?
  referredName  String?
  status        String   @default("pending") // pending, completed, rewarded
  reward        Int      @default(100)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model ProductQuestion {
  id         String   @id @default(cuid())
  product    Product  @relation(fields: [productId], references: [id])
  productId  String
  author     String
  question   String
  answer     String?
  answeredBy String?
  isHelpful  Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model PriceAlert {
  id           String   @id @default(cuid())
  userId       String?
  productId    String
  productName  String?
  targetPrice  Float
  currentPrice Float?
  email        String?
  type         String?
  isTriggered  Boolean  @default(false)
  isActive     Boolean  @default(true)
  notifiedAt   DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model PriceHistory {
  id         String   @id @default(cuid())
  product    Product  @relation(fields: [productId], references: [id])
  productId  String
  price      Float
  recordedAt DateTime @default(now())
  createdAt  DateTime @default(now())
}

model Notification {
  id        String    @id @default(cuid())
  userId    String? // null = broadcast to all
  type      String // order, deal, reward, system, promo, new_arrival, etc.
  title     String
  message   String
  icon      String?
  link      String?
  linkUrl   String?
  metadata  String? // JSON: {price, orderId, productId, imageUrl, etc.}
  priority  String    @default("normal") // low | normal | high | urgent
  category  String? // commerce | social | system | gamification
  expiresAt DateTime?
  isRead    Boolean   @default(false)
  createdAt DateTime  @default(now())

  @@index([userId, isRead])
  @@index([userId, type])
}

model StoreLocation {
  id        String   @id @default(cuid())
  name      String
  address   String
  city      String
  phone     String?
  hours     String?
  latitude  Float?
  longitude Float?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
}

model ShippingMethod {
  id            String   @id @default(cuid())
  name          String
  description   String?
  price         Float
  estimatedDays String?
  freeAbove     Float?
  maxWeight     Float?
  regions       String? // JSON array of supported regions
  icon          String?
  isActive      Boolean  @default(true)
  order         Int      @default(0)
  createdAt     DateTime @default(now())
}

model Wallet {
  id              String              @id @default(cuid())
  userId          String              @unique
  balance         Float               @default(0)
  cashbackBalance Float               @default(0) // Phase 2: Cashback earnings
  currency        String              @default("BDT")
  status          String              @default("active") // "active", "suspended", "closed"
  restrictions    String?             // JSON array of restrictions
  transactions    WalletTransaction[]
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt
}

model WalletTransaction {
  id          String   @id @default(cuid())
  wallet      Wallet   @relation(fields: [walletId], references: [id])
  walletId    String
  type        String // credit, debit
  amount      Float
  description String
  referenceId String?
  createdAt   DateTime @default(now())
}

// === DIGITAL PRODUCTS ENHANCEMENT ===

model DigitalPurchase {
  id                 String    @id @default(cuid())
  userId             String
  user               User      @relation(fields: [userId], references: [id])
  productId          String
  product            Product   @relation(fields: [productId], references: [id])
  purchasePrice      Float
  paymentMethod      String // wallet, stripe, giftcard
  licenseKey         String    @unique
  downloadsRemaining Int       @default(3)
  totalDownloads     Int       @default(0)
  lastDownloadedAt   DateTime?
  isActive           Boolean   @default(true)
  refundedAt         DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  // Reverse relations
  downloadLogs DownloadLog[]
  order        Order?        @relation(fields: [orderId], references: [id])
  orderId      String?

  @@index([userId, productId])
  @@index([licenseKey])
  @@index([orderId])
}

model DownloadLog {
  id                String          @id @default(cuid())
  userId            String
  digitalPurchaseId String
  digitalPurchase   DigitalPurchase @relation(fields: [digitalPurchaseId], references: [id])
  ipAddress         String?
  userAgent         String?
  downloadedAt      DateTime        @default(now())
  success           Boolean         @default(true)
  errorMessage      String?
}

model GiftCardDelivery {
  id              String    @id @default(cuid())
  giftCardId      String
  giftCard        GiftCard  @relation(fields: [giftCardId], references: [id])
  purchaserId     String
  purchaser       User      @relation(fields: [purchaserId], references: [id], name: "GiftCardPurchaser")
  recipientEmail  String
  recipientName   String?
  personalMessage String?
  emailSentAt     DateTime?
  emailOpenedAt   DateTime?
  claimedAt       DateTime?
  status          String    @default("pending") // pending, sent, opened, redeemed, expired
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([giftCardId])
  @@index([recipientEmail])
}

model StudentVerification {
  id                 String    @id @default(cuid())
  userId             String    @unique
  user               User      @relation(fields: [userId], references: [id])
  verificationMethod String // email_domain, id_upload, third_party
  universityEmail    String?
  universityName     String?
  studentIdNumber    String?
  idDocumentUrl      String?
  idDocumentVerified Boolean   @default(false)
  status             String    @default("pending") // pending, verified, rejected, expired
  discountCode       String?
  discountPercent    Int       @default(15)
  verifiedAt         DateTime?
  expiresAt          DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  @@index([userId])
  @@index([universityEmail])
  @@index([status])
}

model Auction {
  id              String       @id @default(cuid())
  productId       String
  product         Product      @relation(fields: [productId], references: [id])
  sellerId        String?
  seller          Seller?      @relation(fields: [sellerId], references: [id])
