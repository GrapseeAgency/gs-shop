<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Grapsee" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/jade</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
        <item name="postSplashScreenTheme">@style/Theme.Grapsee.Main</item>
    </style>

    <style name="Theme.Grapsee.Main" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="android:windowBackground">@android:color/white</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>
</resources>
