            </div>
            <div>
              <h2 className="text-base font-bold text-foreground">Grapsee Technologies</h2>
              <p className="text-[11px] text-muted-foreground">Digital Excellence Since 2020</p>
            </div>
          </div>
          <p className="text-sm leading-relaxed text-foreground/80 mb-3">
            Grapsee is a premium digital marketplace where businesses discover world-class digital services. From stunning websites to powerful mobile apps and enterprise DevOps  -  we craft solutions that transform ideas into reality.
          </p>
          <div className="flex items-center gap-2">
            <Badge className="bg-primary/20 text-primary border-0">
              <Crown className="mr-1 h-3 w-3" />
              Premium Mall
            </Badge>
            <Badge className="bg-emerald-500/20 text-emerald-400 border-0">
              <CheckCircle2 className="mr-1 h-3 w-3" />
              120+ Countries
            </Badge>
          </div>
        </div>
      </motion.div>

      {/* Vision Statement */}
      <motion.section
