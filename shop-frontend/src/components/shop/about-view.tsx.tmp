          <div className="flex h-8 w-8 items-center justify-center rounded-lg bg-primary/20 mb-2">
            <Rocket className="h-4 w-4 text-primary" />
          </div>
          <h4 className="text-xs font-bold text-foreground mb-1">Our Mission</h4>
          <p className="text-[10px] leading-relaxed text-muted-foreground">
            Democratize access to premium digital services for businesses worldwide.
          </p>
        </motion.div>
        <motion.div variants={item} className="rounded-2xl border border-border/50 bg-gradient-to-br from-violet-500/10 to-violet-500/5 p-3">
          <div className="flex h-8 w-8 items-center justify-center rounded-lg bg-violet-500/20 mb-2">
            <Gem className="h-4 w-4 text-violet-400" />
